[project]
authors = [
    {name = "Aaron Steele", email = "aaron@chi-fro.org"},
    {name = "Andrew Bolton", email = "andrew@chi-fro.org"}
]
name = "smcnn"
requires-python = ">= 3.11"
version = "0.1.0"
dependencies = [
    "genjax>=0.8.2.dev1,<0.9",
    "genstudio>=2025.2.2,<2026",
    "pillow>=10.4.0,<11",
    "ipython>=8.32.0,<9",
    "ipykernel>=6.29.5,<7",
    "jax>=0.4.38,<0.5",
    "seaborn>=0.13.2,<0.14",
    "pyqt5>=5.15.11,<6",
    "tensorflow",
    "tensorflow-probability>=0.23.0,<0.24",
    "astropy>=7.0.1,<8"
]

[build-system]
build-backend = "hatchling.build"
requires = ["hatchling"]

[tool.pixi.project]
channels = ["conda-forge"]
platforms = ["osx-arm64"]

